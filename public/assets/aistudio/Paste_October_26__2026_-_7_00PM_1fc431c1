4. Repository (repository/AddonRepository.kt)
package com.example.stremiolite.repository

import android.content.Context
import com.example.stremiolite.model.*
import com.example.stremiolite.network.AddonApiService
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import okhttp3.OkHttpClient
import okhttp3.logging.HttpLoggingInterceptor
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory

class AddonRepository(context: Context) {
    private val prefs = context.getSharedPreferences("stremio_lite_prefs", Context.MODE_PRIVATE)

    private val client = OkHttpClient.Builder()
        .addInterceptor(HttpLoggingInterceptor().apply { level = HttpLoggingInterceptor.Level.BODY })
        .build()

    private val retrofit = Retrofit.Builder()
        .baseUrl("https://v3-cinemeta.strem.io/") // dummy base, overridden by full @Url
        .client(client)
        .addConverterFactory(GsonConverterFactory.create())
        .build()

    private val api = retrofit.create(AddonApiService::class.java)

    // Default built-in addons (Cinemeta for metadata)
    private val defaultAddons = listOf(
        "https://v3-cinemeta.strem.io/manifest.json"
    )

    fun getInstalledAddonUrls(): List<String> {
        val saved = prefs.getStringSet("installed_addons", null)
        if (saved.isNullOrEmpty()) {
            saveInstalledAddons(defaultAddons)
            return defaultAddons
        }
        return saved.toList()
    }

    fun saveInstalledAddons(urls: List<String>) {
        prefs.edit().putStringSet("installed_addons", urls.toSet()).apply()
    }

    suspend fun fetchManifest(baseUrl: String): AddonManifest = withContext(Dispatchers.IO) {
        val url = if (baseUrl.endsWith("manifest.json")) baseUrl else "$baseUrl/manifest.json"
        api.getManifest(url)
    }

    suspend fun fetchCatalog(addonBaseUrl: String, type: String, catalogId: String): List<MetaItem> = withContext(Dispatchers.IO) {
        try {
            val base = addonBaseUrl.removeSuffix("/manifest.json")
            val url = "$base/catalog/$type/$catalogId.json"
            val response = api.getCatalog(url)
            response.metas
        } catch (e: Exception) {
            e.printStackTrace()
            emptyList()
        }
    }

    suspend fun fetchMetaDetail(addonBaseUrl: String, type: String, id: String): MetaItem? = withContext(Dispatchers.IO) {
        try {
            val base = addonBaseUrl.removeSuffix("/manifest.json")
            val url = "$base/meta/$type/$id.json"
            val response = api.getMeta(url)
            response.meta
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }

    suspend fun fetchStreams(addonBaseUrl: String, type: String, id: String): List<StreamItem> = withContext(Dispatchers.IO) {
        try {
            val base = addonBaseUrl.removeSuffix("/manifest.json")
            val url = "$base/stream/$type/$id.json"
            val response = api.getStreams(url)
            response.streams
        } catch (e: Exception) {
            e.printStackTrace()
            emptyList()
        }
    }
}

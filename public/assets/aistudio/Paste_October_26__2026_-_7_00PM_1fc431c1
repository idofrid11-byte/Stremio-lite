package com.example.stremiolite.ui.viewmodel

import android.app.Application
import androidx.compose.runtime.*
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import com.example.stremiolite.model.AddonManifest
import com.example.stremiolite.model.MetaItem
import com.example.stremiolite.repository.AddonRepository
import kotlinx.coroutines.launch

class MainViewModel(application: Application) : AndroidViewModel(application) {
    private val repository = AddonRepository(application)

    var installedAddonUrls = mutableStateOf(repository.getInstalledAddonUrls())
        private set

    var manifests = mutableStateMapOf<String, AddonManifest>()
        private set

    var catalogs = mutableStateMapOf<String, List<MetaItem>>() // Key: "addonUrl_type_catalogId"
        private set

    var searchQuery = mutableStateOf("")
    var searchResults = mutableStateOf<List<MetaItem>>(emptyList())
        private set

    var isLoading = mutableStateOf(false)
        private set

    init {
        loadAddonsAndCatalogs()
    }

    fun loadAddonsAndCatalogs() {
        viewModelScope.launch {
            isLoading.value = true
            val urls = repository.getInstalledAddonUrls()
            installedAddonUrls.value = urls

            for (url in urls) {
                try {
                    val manifest = repository.fetchManifest(url)
                    manifests[url] = manifest

                    for (cat in manifest.catalogs) {
                        val items = repository.fetchCatalog(url, cat.type, cat.id)
                        catalogs["${url}_${cat.type}_${cat.id}"] = items
                    }
                } catch (e: Exception) {
                    e.printStackTrace()
                }
            }
            isLoading.value = false
        }
    }

    fun addAddon(url: String) {
        viewModelScope.launch {
            try {
                val manifest = repository.fetchManifest(url)
                val current = installedAddonUrls.value.toMutableList()
                if (!current.contains(url)) {
                    current.add(url)
                    repository.saveInstalledAddons(current)
                    loadAddonsAndCatalogs()
                }
            } catch (e: Exception) {
                e.printStackTrace()
            }
        }
    }

    fun removeAddon(url: String) {
        val current = installedAddonUrls.value.toMutableList()
        current.remove(url)
        repository.saveInstalledAddons(current)
        loadAddonsAndCatalogs()
    }
}

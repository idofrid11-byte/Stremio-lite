    var meta by remember { mutableStateOf<MetaItem?>(null) }
    var streams by remember { mutableStateOf<List<StreamItem>>(emptyList()) }
    var selectedVideoId by remember { mutableStateOf(id) }
    var isLoadingStreams by remember { mutableStateOf(false) }

    LaunchedEffect(id) {
        meta = repository.fetchMetaDetail(addonUrl, type, id)
        loadStreams(addonUrl, type, selectedVideoId, repository) { streams = it }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(meta?.name ?: "Details") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { padding ->
        if (meta == null) {
            Box(modifier = Modifier.fillMaxSize().padding(padding), contentAlignment = Alignment.Center) {
                CircularProgressIndicator()
            }
        } else {
            LazyColumn(
                modifier = Modifier.fillMaxSize().padding(padding),
                contentPadding = PaddingValues(16.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                item {
                    Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(16.dp)) {
                        AsyncImage(
                            model = meta!!.poster,
                            contentDescription = meta!!.name,
                            modifier = Modifier.width(120.dp).height(180.dp),
                            contentScale = ContentScale.Crop
                        )
                        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                            Text(meta!!.name, style = MaterialTheme.typography.titleLarge)
                            Text("Year: ${meta!!.releaseInfo ?: "N/A"}", style = MaterialTheme.typography.bodyMedium)
                            Text(meta!!.description ?: "", style = MaterialTheme.typography.bodySmall, maxLines = 5)
                        }
                    }
                }

                // If Series, show episodes
                if (!meta!!.videos.isNullOrEmpty()) {
                    item {
                        Text("Episodes", style = MaterialTheme.typography.titleMedium)
                    }
                    items(meta!!.videos!!) { video ->
                        Card(
                            modifier = Modifier
                                .fillMaxWidth()
                                .clickable {
                                    selectedVideoId = video.id
                                    scope.launch {
                                        isLoadingStreams = true
                                        streams = repository.fetchStreams(addonUrl, type, video.id)
                                        isLoadingStreams = false
                                    }
                                },
                            colors = CardDefaults.cardColors(
                                containerColor = if (selectedVideoId == video.id) MaterialTheme.colorScheme.primaryContainer
                                else MaterialTheme.colorScheme.surfaceVariant
                            )
                        ) {
                            Text(
                                text = video.title ?: "Episode ${video.episode}",
                                modifier = Modifier.padding(16.dp),
                                style = MaterialTheme.typography.bodyMedium
                            )
                        }
                    }
                }

                item {
                    Text("Available Streams", style = MaterialTheme.typography.titleLarge)
                }

                if (isLoadingStreams) {
                    item {
                        Box(modifier = Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
                            CircularProgressIndicator()
                        }
                    }
                } else if (streams.isEmpty()) {
                    item {
                        Text("No streams found for this video.")
                    }
                } else {
                    items(streams) { stream ->
                        Card(
